{
  "name": "app2-owner",
  "private": true,
  "version": "1.1.12",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "KBM Printing",
  "description": "Dashboard Keuangan & Laporan KBM Owner",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron electron/main.cjs\"",
    "electron:build:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@ionic/vue": "^9.0.4",
    "@ionic/vue-router": "^9.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "chart.js": "^4.5.1",
    "konsta": "^5.4.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "electronVersion": "44.4.3",
    "appId": "com.kbmprinting.owner",
    "productName": "KBM Owner",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KBM Owner"
    }
  }
}
